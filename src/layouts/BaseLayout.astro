---
// Minimal page skeleton (no styling, by design).
const { title = 'Astro Auth Template' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/register">Register</a>
      <a href="/login">Login</a>
      <a href="/dashboard">Dashboard</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
